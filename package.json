  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/module.js",
  "types": "dist/module.d.ts",
  "files": [
    "dist",
    "matterbridge-dynalite.schema.json",
    "matterbridge-dynalite.config.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0 <21.0.0 || >=22.0.0 <23.0.0 || >=24.0.0 <25.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonaskul/matterbridge-dynalite.git"
  },
  "bugs": {
    "url": "https://github.com/jonaskul/matterbridge-dynalite/issues"
  },
  "homepage": "https://github.com/jonaskul/matterbridge-dynalite#readme",
  "keywords": [
    "matterbridge",
    "plugin",
    "dynalite",
    "dynet",
    "philips",
    "signify",
    "lighting",
    "thermostat",
    "matter",
    "homekit",
    "google-home",
    "alexa",
    "smartthings"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "dev:link": "npm link matterbridge"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
